FACE_API_URL=http://localhost:8080
FACE_DEVICE_UID=
FACE_DEVICE_SECRET=
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Dùng tài khoản broker của thiết bị này; thông tin đăng nhập cục bộ không được đưa vào Git.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartdoor-iot
FACE_MODEL_ROOT=models
FACE_ORT_THREADS=2
FACE_CAMERA_SOURCE=0
FACE_THRESHOLD=0.50
FACE_MARGIN=0.08
FACE_STABLE_FRAMES=3
FACE_COOLDOWN_SECONDS=10
FACE_SYNC_SECONDS=5
FACE_MAX_FRAME_AGE_SECONDS=2
FACE_MIN_FACE_SIZE=80
FACE_MIN_BLUR=40
FACE_LIVENESS_ENABLED=true
FACE_LIVENESS_THRESHOLD=0.8
# Chỉ dùng khi phát triển cục bộ và cần bật cho phép rõ ràng ở máy chủ.
FACE_ALLOW_UNVERIFIED_LIVENESS=false
