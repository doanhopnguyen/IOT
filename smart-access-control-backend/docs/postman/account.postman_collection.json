{
  "info": {
    "name": "Smart Access — Tài khoản",
    "description": "Chạy trên database kiểm thử. Tạo tài khoản mới và thay đổi dữ liệu. Chạy thư mục 1 trước; thư mục 2 cần admin có sẵn. Cookie jar bật; CSRF được lấy tự động trước request ghi. Không lưu credentials thật vào collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '02 Đăng ký tài khoản') {",
          "  const password = pm.environment.get('accountPassword');",
          "  const next = pm.environment.get('newPassword');",
          "  if (!password || !next || password === next) throw new Error('Nhập accountPassword/newPassword khác nhau tại máy; không lưu credential vào file Git');",
          "}",
          "if (pm.info.requestName === '02 Đăng ký tài khoản') {",
          "  const suffix = Date.now().toString() + Math.floor(Math.random() * 10000);",
          "  pm.collectionVariables.set('testEmail', 'account-' + suffix + '@example.test');",
          "  pm.collectionVariables.set('updatedEmail', 'updated-' + suffix + '@example.test');",
          "  pm.collectionVariables.set('testPhone', '09' + suffix.slice(-8));",
          "  pm.collectionVariables.set('updatedPhone', '08' + suffix.slice(-8));",
          "}",
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method)) {",
          "  pm.sendRequest({url: pm.environment.get('baseUrl') + '/api/auth/csrf', method: 'GET'}, (err, res) => {",
          "    if (err || res.code !== 200) throw new Error('Không lấy được CSRF; kiểm tra session và backend');",
          "    const csrf = res.json();",
          "    pm.request.headers.upsert({key: csrf.headerName, value: csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Tài khoản",
      "item": [
        {
          "name": "01 Chưa đăng nhập",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/accounts/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Đăng ký tài khoản",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người dùng kiểm thử\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"{{accountPassword}}\",\n  \"admin\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountId', String(pm.response.json().accountId));",
                  "pm.test('Tài khoản thường ACTIVE', () => { pm.expect(pm.response.json().admin).to.eql(false); pm.expect(pm.response.json().status).to.eql('ACTIVE'); });",
                  "pm.test('Không lộ mật khẩu', () => { pm.expect(pm.response.json()).not.to.have.property('passwordHash'); pm.expect(pm.response.json()).not.to.have.property('password'); });"
                ]
              }
            }
          ]
        },
