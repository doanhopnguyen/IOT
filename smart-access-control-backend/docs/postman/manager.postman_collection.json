  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const other = pm.info.requestName.startsWith('20 ');",
          "const identifier = pm.environment.get(other ? 'otherManagerIdentifier' : 'managerIdentifier');",
          "const password = pm.environment.get(other ? 'otherManagerPassword' : 'managerPassword');",
          "if (!identifier || !password) throw new Error('Cần điền thông tin đăng nhập manager trong environment');",
          "const base = pm.environment.get('baseUrl');",
          "pm.sendRequest({url:base+'/api/auth/csrf',method:'GET'},(err,res)=>{",
          "  if(err || res.code!==200) throw new Error('Không lấy được CSRF trước đăng nhập');",
          "  const csrf=res.json();",
          "  pm.sendRequest({url:base+'/api/auth/login',method:'POST',header:{'Content-Type':'application/json',[csrf.headerName]:csrf.token},body:{mode:'raw',raw:JSON.stringify({identifier,password})}},(err,login)=>{",
          "    if(err || login.code!==200) throw new Error('Đăng nhập manager thất bại');",
          "    pm.sendRequest({url:base+'/api/auth/csrf',method:'GET'},(err,res)=>{",
          "      if(err || res.code!==200) throw new Error('Không lấy được CSRF sau đăng nhập');",
          "      const fresh=res.json(); pm.request.headers.upsert({key:fresh.headerName,value:fresh.token});",
          "    });",
          "  });",
          "});"
        ]
      }
    }
  ]
}
