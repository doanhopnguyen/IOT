{
  "info": {
    "name": "Smart Door Manager — existing schema",
    "description": "Các flow Manager trên database fixture riêng. Cần managerIdentifier/managerPassword và otherManagerIdentifier/otherManagerPassword; pre-request đăng nhập đúng manager và lấy CSRF tự động. Cookie jar bật. Query managerId không còn xác định danh tính.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Search by accountId",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/manager/users/search?keyword={{userId}}&type=account"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Safe user response', () => { const rows = pm.response.json(); pm.expect(rows).to.have.length(1); pm.expect(String(rows[0].id)).to.eql(pm.environment.get('userId')); pm.expect(rows[0]).not.to.have.property('passwordHash'); pm.expect(rows[0]).not.to.have.property('admin'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Search by email",
