DB_URL=
FACE_PROCESSOR_URL=http://127.0.0.1:8091/extract
FACE_PROCESSOR_TOKEN=
DB_USERNAME=
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SESSION_COOKIE_SECURE=false
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_TOPIC_PREFIX=smartdoor-iot
MQTT_USERNAME=
MQTT_PASSWORD=
FACE_MATCH_THRESHOLD=0.5
FACE_ALLOW_UNVERIFIED_LIVENESS=false
USB_ENABLED=false
# Broker address written into each ESP32 when admin uses "Nạp code" (must be reachable from the chip).
# The broker must run the Mosquitto dynamic-security plugin; MQTT_USERNAME needs its admin role.
PROVISION_MQTT_HOST=
PROVISION_MQTT_PORT=1884
PROVISION_MQTT_TLS=false
PROVISION_MQTT_CA_FILE=
# Enable only on a trusted backend computer used to prepare USB devices.
# The local launcher auto-detects PlatformIO tools when USB_ENABLED is not set.
USB_PYTHON_EXECUTABLE=python
USB_ESPTOOL_SCRIPT=
# ESP32-reachable backend URL for OTA downloads. Use this PC's LAN IPv4,
# not localhost or a Tailscale address (ESP32 has no Tailscale client).
APP_DEVICE_BASE_URL=http://192.168.1.10:8080
