# Sao chép thành deployment/.env rồi điền giá trị thật. KHÔNG commit file .env.
DB_NAME=smart_access
DB_USERNAME=smartdoor
DB_PASSWORD=doi-mat-khau-nay
MYSQL_ROOT_PASSWORD=doi-mat-khau-root-nay

# Mật khẩu user MQTT "backend"
MQTT_PASSWORD=doi-mat-khau-mqtt-nay
# Tài khoản MQTT cho từng thiết bị: username = UID thiết bị, phân tách bằng dấu phẩy
MQTT_DEVICE_ACCOUNTS=
MQTT_PORT=1883

BACKEND_PORT=8080
# Địa chỉ trang web/app được gọi API (thêm IP LAN nếu mở app từ điện thoại)
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Đặt true khi chạy sau HTTPS
SESSION_COOKIE_SECURE=false
