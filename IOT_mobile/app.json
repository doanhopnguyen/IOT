{
  "expo": {
    "name": "Smart Door",
    "slug": "smart-door",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "smartdoor",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartdoor.mobile",
      "entitlements": { "com.apple.developer.networking.HotspotConfiguration": true },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Kết nối và thiết lập Wi-Fi cho khóa Smart Door của bạn.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "com.smartdoor.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Smart Door quét QR sản phẩm và đăng ký khuôn mặt.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-font",
      "./plugins/withSetupWifi"
    ]
  }
}
