EXPO_PUBLIC_API_BASE_URL=http://YOUR_BACKEND_LAN_IP:8080
# A physical phone needs a reachable LAN address. Restart Expo after changing this.
# Authentication owner should setApiAuthorization from its session, not from public env secrets.
# Optional development-only JSON mapping from mock door IDs to your existing access_units IDs:
# Existing local demo only; verify these IDs against your own database:
# EXPO_PUBLIC_DEMO_DOOR_IDS={"home":1,"office":2}
